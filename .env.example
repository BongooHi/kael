# Get your Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Voice options: Schedar, Umbriel, Algenib, Enceladus, Iapetus, Charon, Orus
KAEL_VOICE=Schedar

# Optional sci-fi metallic voice filter (0.0 = natural, 0.7 = metallic)
KAEL_VOICE_FX=0.0

# Voice barge-in threshold (higher = harder to interrupt Kael while speaking)
KAEL_BARGE_IN_THRESHOLD=0.32

# Custom offline wake words (comma-separated)
KAEL_WAKE_WORDS=kale,kael,hey kale,hey kael
KAEL_WAKE_CONFIDENCE=0.70
KAEL_WAKE_MIN_RMS=220

# Seconds of silence before Kael returns to standby
KAEL_IDLE_TIMEOUT=18
