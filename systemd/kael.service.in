[Unit]
Description=Kael AI Voice Assistant for Linux (PipeWire + Gemini Live)
After=graphical-session.target pipewire.service pipewire-pulse.service kael-hud.service
Wants=kael-hud.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@@INSTALL_DIR@@
ExecStart=@@INSTALL_DIR@@/.venv/bin/python @@INSTALL_DIR@@/kael.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
