[Unit]
Description=Kael Wayland GPU Edge Glow & Captions HUD
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@@INSTALL_DIR@@
ExecStart=@@INSTALL_DIR@@/.venv/bin/python @@INSTALL_DIR@@/hud.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
